# Run python3 scripts/setup.py to create .env and local secrets.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. Empty rejects everyone.
TELEGRAM_ALLOWED_USER_IDS=
BRIDGE_TOKEN=replace-with-generated-secret
MEDIA_PASSWORD=replace-with-generated-secret
N8N_ENCRYPTION_KEY=replace-with-generated-secret
# Set to the encrypted graph UUID; token and graph key live in .secrets/.
LOGSEQ_GRAPH_ID=
LOGSEQ_API_URL=http://logseq-sync:8787
# Browser links assume the SSH tunnel documented in README.md.
MEDIA_BASE_URL=http://localhost:8001
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.44.6
LOGSEQ_WEB_IMAGE=ghcr.io/yshalsager/logseq-selfhost-web:latest
LOGSEQ_SYNC_IMAGE=ghcr.io/yshalsager/logseq-selfhost-sync-worker:latest
# Set by deploy-lightsail.py --public-ip; leave empty for SSH-only deployment.
PUBLIC_IP=
COMPOSE_PROFILES=
CADDY_IMAGE=caddy:2.11.7-alpine
# Generated during public deployment from MEDIA_PASSWORD; do not edit manually.
WEB_PASSWORD_HASH=
# AI stays off until explicitly enabled; the API key belongs in .secrets/gemini-api-key.
AI_ENABLED=false
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
