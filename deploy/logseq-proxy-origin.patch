+
+(defn public-origin
+  "Preserve TLS terminated by the trusted local reverse proxy."
+  [request]
+  (let [url (js/URL. (.-url request))]
+    (when (= "https" (.get (.-headers request) "x-forwarded-proto"))
+      (set! (.-protocol url) "https:"))
+    (.-origin url)))
 
 (defn cors-headers []
   #js {"Access-Control-Allow-Origin" "*"
