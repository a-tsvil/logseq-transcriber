{
    # IP-address connections typically omit SNI.
    default_sni {$PUBLIC_IP}
}

(ip_certificate) {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
            # Certificate renewal uses port 80.
            disable_tlsalpn_challenge
        }
    }
}

https://{$PUBLIC_IP} {
    import ip_certificate
    handle /media/* {
        reverse_proxy inbox:8080
    }
    handle {
        respond 404
    }
}

https://{$PUBLIC_IP}:8443 {
    import ip_certificate
    @policy path /training /training/* /admin /admin/*
    respond @policy 404
    reverse_proxy logseq-sync:8787
}
